/* ============================================================
   MASTER STYLESHEET - LIBRARY MANAGEMENT SYSTEM
   Theme: Deep Dark Professional
   Design Philosophy: Card-Based, Visual Hierarchy, Clean Spacing
   ============================================================ */

/* ============ COLOR PALETTE ============
   Background Main:  #1a1d29 (Deep Blue Slate)
   Card Background:  #1e2230 (Card Surface)
   Border:           #2d3140 (Subtle Border)
   Accent Primary:   #0078D4 (Primary Blue)
   Text Primary:     #E0E0E0 (White)
   Text Secondary:   #9B9B9B (Gray)
   Success:          #34d399 (Emerald)
   Warning:          #fbbf24 (Amber)
   Danger:           #f87171 (Red)
   ======================================== */

/* ============ GLOBAL STRUCTURE ============ */
QWidget {
    font-family: "Segoe UI", "Roboto", sans-serif;
    font-size: 13px;
    color: #FFFFFF;
}

/* Nền chính (Deep Blue Slate) */
QMainWindow, QWidget#CentralWidget, 
.WidgetBangDieuKhien, .WidgetQuanLySach, 
.WidgetQuanLyDocGia, .WidgetMuonTraSach {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, 
        stop:0 #1a1d29, stop:0.5 #1e2230, stop:1 #1a1d29);
}

/* ============ CARD CONTAINERS ============ */
QFrame[class="Card"] {
    background-color: #1e2230;
    border-radius: 12px;
    border: 1px solid #2d3140;
}

/* Card cho cột trái (Profile Panel) */
QFrame[class="ProfileCard"] {
    background-color: #1e2230;
    border-right: 1px solid #2d3140;
    border-radius: 0px;
}

/* ============ TEXT STYLES ============ */
QLabel[class="PageTitle"] {
    font-size: 24px;
    font-weight: 800;
    color: #FFFFFF;
    margin-bottom: 15px;
    background: transparent;
}

QLabel[class="CardTitle"] {
    font-size: 16px;
    font-weight: 700;
    color: #FFFFFF;
    border-bottom: 1px solid #2B2B40;
    padding-bottom: 12px;
    margin-bottom: 10px;
    background: transparent;
}

QLabel[class="SubText"] {
    color: #9B9B9B;
    font-size: 12px;
    background: transparent;
}

/* Legacy support */
QLabel[class="HeaderTitle"] {
    font-size: 24px;
    font-weight: bold;
    color: #FFFFFF;
    padding-bottom: 10px;
    background: transparent;
}

QLabel[class="SectionTitle"] {
    font-size: 16px;
    font-weight: 600;
    color: #FFFFFF;
    background: transparent;
}

/* ============ SIDEBAR - ROUNDED PILL STYLE ============ */
QListWidget#Sidebar, QListWidget {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                               stop:0 #27272a, stop:1 #18181b);
    border: none;
    border-right: 1px solid rgba(59, 130, 246, 0.08);
    outline: 0;
    padding-top: 0px;
}

QListWidget#Sidebar::item, QListWidget::item {
    color: #a1a1aa;
    padding: 14px 20px;
    margin: 8px 16px;
    border-radius: 12px;
    font-weight: 600;
    font-size: 14px;
    background-color: transparent;
    border: none;
}

QListWidget#Sidebar::item:hover, QListWidget::item:hover {
    background: rgba(59, 130, 246, 0.12);
    color: #60a5fa;
    transform: translateX(2px);
}

QListWidget#Sidebar::item:selected, QListWidget::item:selected {
    background: rgba(59, 130, 246, 0.20);
    color: #ffffff;
    font-weight: 700;
    border: none;
}

/* ============ BUTTONS ============ */
QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                               stop:0 #27272a, stop:1 #18181b);
    color: #a1a1aa;
    border: 1.5px solid #3f3f46;
    border-radius: 8px;
    padding: 12px 24px;
    font-weight: 600;
    font-size: 13px;
}

QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                               stop:0 #3f3f46, stop:1 #27272a);
    border: 1.5px solid #60a5fa;
    color: #60a5fa;
}

QPushButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                               stop:0 #18181b, stop:1 #09090b);
}

QPushButton:disabled {
    background-color: #18181b;
    color: #52525b;
    border-color: #3f3f46;
}

/* Primary Button - Blue */
QPushButton[class="Primary"], QPushButton[class="btn-primary"] {
    background-color: #3699FF;
    color: white;
    border: none;
    font-weight: 700;
    padding: 10px 20px;
    border-radius: 8px;
}

QPushButton[class="Primary"]:hover, QPushButton[class="btn-primary"]:hover {
    background-color: #0073E6;
}

QPushButton[class="Primary"]:pressed, QPushButton[class="btn-primary"]:pressed {
    background-color: #0066CC;
}

/* Secondary Button */
QPushButton[class="Secondary"], QPushButton[class="btn-secondary"] {
    background-color: #323248;
    color: #B5B5C3;
    border: 1px solid #323248;
    font-weight: 600;
}

QPushButton[class="Secondary"]:hover, QPushButton[class="btn-secondary"]:hover {
    background-color: #2A2A3C;
    color: white;
}

/* Success Button - Green */
QPushButton[class="Success"], QPushButton[class="btn-success"] {
    background-color: #1BC5BD;
/* ============ INPUT FIELDS ============ */
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDateEdit {
    background-color: #18181b;
    border: 2px solid #3f3f46;
    border-radius: 8px;
    padding: 10px 15px;
    color: #e4e4e7;
    font-weight: 500;
    selection-background-color: #3B82F6;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QSpinBox:focus, QDateEdit:focus {
    border: 2px solid #60a5fa;
    background-color: #27272a;
    outline: none;
}

QLineEdit:disabled, QTextEdit:disabled, QPlainTextEdit:disabled {
    background-color: #18181b;
    color: #52525b;
    border-color: #3f3f46;
}PushButton[class="Danger"], QPushButton[class="btn-danger"] {
    background-color: #F64E60;
    color: white;
    border: none;
    font-weight: 600;
/* ============ COMBO BOX ============ */
QComboBox {
    background-color: #18181b;
    border: 2px solid #3f3f46;
    border-radius: 8px;
    padding: 10px 15px;
    color: #e4e4e7;
    min-width: 140px;
    font-weight: 500;
}

QComboBox:focus {
    border: 2px solid #60a5fa;
    background-color: #27272a;
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QSpinBox:focus {
    border: 2px solid #3699FF;
    background-color: #1A1A26;
    outline: none;
}

QLineEdit:disabled, QTextEdit:disabled, QPlainTextEdit:disabled {
    background-color: #1A1A26;
    color: #5A5A6C;
    border-color: #2B2B40;
}

/* ============ COMBO BOX ============ */
QComboBox {
/* ============ COMBO BOX ============ */
QComboBox {
    background-color: #151521; /* Nền input tối hơn nền Card */
    color: #FFFFFF;
    border: 2px solid #2B2B40;
    border-radius: 8px;
    padding: 8px 12px;
    min-width: 140px;
    font-weight: 500;
}

QComboBox:focus {
    border: 2px solid #3699FF;
    background-color: #1A1A26;
}ComboBox::drop-down {
/* ============ TABLES ============ */
QTableView, QTableWidget {
    background-color: #27272a;
    border: 1px solid #3f3f46;
    border-radius: 8px;
    gridline-color: #3f3f46;
    selection-background-color: rgba(59, 130, 246, 0.15);
    selection-color: #60a5fa;
    outline: 0;
    color: #a1a1aa;
}

QTableView::item, QTableWidget::item {
    padding: 8px;
    border-bottom: 1px solid #3f3f46;
}

QTableView::item:hover, QTableWidget::item:hover {
    background-color: rgba(59, 130, 246, 0.08);
}

QTableView::item:selected, QTableWidget::item:selected {
    background-color: rgba(59, 130, 246, 0.15);
    color: #e4e4e7;
}

QHeaderView {
    background-color: #27272a;
    border: none;
}

QHeaderView::section {
    background-color: #18181b;
    color: #a1a1aa;
    padding: 12px;
    border: none;
    border-bottom: 2px solid #3f3f46;
    font-weight: 700;
    text-transform: uppercase;
    font-size: 11px;
    letter-spacing: 1px;
}

QHeaderView::section:hover {
    background-color: #27272a;
    color: #60a5fa;
}   background-color: rgba(54, 153, 255, 0.08);
}

QTableView::item:selected, QTableWidget::item:selected {
    background-color: rgba(54, 153, 255, 0.15);
    color: #FFFFFF;
}

QHeaderView {
    background-color: #1E1E2D;
    border: none;
}

QHeaderView::section {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                               stop:0 #232334, stop:1 #1E1E2D);
    color: #B5B5C3;
    padding: 14px 12px;
    border: none;
    border-bottom: 2px solid rgba(54, 153, 255, 0.3);
    font-weight: 700;
    text-transform: uppercase;
    font-size: 11px;
    letter-spacing: 1.2px;
}

QHeaderView::section:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                               stop:0 #2B2B40, stop:1 #232334);
    color: #3699FF;
}

/* ============ LABELS ============ */
QLabel {
    color: #FFFFFF;
    background-color: transparent;
    border: none;
}

QLabel[class="title"] {
    font-size: 28px;
    font-weight: 700;
    color: #FFFFFF;
    letter-spacing: -0.5px;
}

QLabel[class="subtitle"] {
    font-size: 15px;
    color: #B5B5C3;
    font-weight: 500;
}

QLabel[class="caption"] {
    font-size: 12px;
    color: #B5B5C3;
    font-weight: 400;
}

/* ============ TABS ============ */
QTabWidget::pane {
    border: 1px solid #2B2B40;
    border-radius: 8px;
    background-color: #1E1E2D;
    top: -1px;
}

QTabBar::tab {
    background-color: transparent;
    color: #B5B5C3;
    border: none;
    border-bottom: 3px solid transparent;
    padding: 14px 28px;
    margin-right: 6px;
    font-weight: 600;
    font-size: 14px;
    border-radius: 8px 8px 0 0;
}

QTabBar::tab:selected {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                               stop:0 rgba(54, 153, 255, 0.15),
                               stop:1 transparent);
    color: #3699FF;
    border-bottom: 3px solid qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                            stop:0 #3699FF, stop:1 #10B981);
    font-weight: 700;
}

QTabBar::tab:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                               stop:0 rgba(54, 153, 255, 0.12),
                               stop:1 transparent);
    color: #3699FF;
}
/* ============ SCROLLBAR - Dark Theme ============ */
QScrollBar:vertical {
    background-color: #1E293B;
    width: 12px;
    border-radius: 6px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background-color: #475569;
    border-radius: 6px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background-color: #64748B;
}

QScrollBar::handle:vertical:pressed {
    background-color: #3699FF;
}

QScrollBar:horizontal {
    background-color: #1E293B;
    height: 10px;
    border-radius: 5px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background-color: #475569;
    border-radius: 5px;
    min-width: 40px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #3699FF;
}

QScrollBar::add-line, QScrollBar::sub-line {
    background: none;
    border: none;
    width: 0;
    height: 0;
}

QScrollBar::add-page, QScrollBar::sub-page {
    background: none;
}

/* ============ SPIN BOX ============ */
QSpinBox, QDoubleSpinBox {
    background-color: #2D2D3F;
    color: #E2E8F0;
    border: 1.5px solid #475569;
    border-radius: 8px;
    padding: 10px 14px;
    font-weight: 600;
}

QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1.5px solid #3699FF;
}

QSpinBox::up-button, QDoubleSpinBox::up-button,
QSpinBox::down-button, QDoubleSpinBox::down-button {
    background-color: #374151;
    border: none;
    border-radius: 6px;
    width: 20px;
    margin: 2px;
}

QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: #3699FF;
}

/* ============ DIALOGS ============ */
QDialog {
    background-color: #1E1E2D;
}

QDialog QPushButton {
    min-width: 100px;
}

/* ============ MESSAGE BOX ============ */
QMessageBox {
    background-color: #2D2D3F;
}

QMessageBox QLabel {
    color: #E2E8F0;
    font-size: 14px;
}

/* ============ PROGRESS BAR ============ */
QProgressBar {
    border: none;
    border-radius: 8px;
    background-color: #1E293B;
    text-align: center;
    color: #E2E8F0;
    font-weight: 700;
    height: 20px;
}

QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #3699FF, stop:1 #10B981);
    border-radius: 8px;
}

/* ============ CHECKBOX ============ */
QCheckBox {
    color: #E2E8F0;
    font-weight: 600;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 20px;
    height: 20px;
    border: 2px solid #475569;
    border-radius: 6px;
    background-color: #2D2D3F;
}

QCheckBox::indicator:hover {
    border-color: #3699FF;
}

QCheckBox::indicator:checked {
    background-color: #3699FF;
    border-color: #3699FF;
}

/* ============ RADIO BUTTON ============ */
QRadioButton {
    color: #E2E8F0;
    font-weight: 600;
    spacing: 8px;
}

QRadioButton::indicator {
    width: 20px;
    height: 20px;
    border: 2px solid #475569;
    border-radius: 10px;
    background-color: #2D2D3F;
}

QRadioButton::indicator:hover {
    border-color: #3699FF;
}

QRadioButton::indicator:checked {
    background-color: #3699FF;
    border-color: #3699FF;
}

/* ============ TOOLBAR ============ */
QToolBar {
    background-color: #2D2D3F;
    border: none;
    border-bottom: 1px solid #475569;
    padding: 8px;
    spacing: 8px;
}

QToolButton {
    background-color: transparent;
    border: none;
    border-radius: 8px;
    padding: 8px;
    color: #94A3B8;
}

QToolButton:hover {
    background-color: #374151;
    color: #3699FF;
}

QToolButton:pressed {
    background-color: #1E293B;
}

/* ============ SPLITTER ============ */
QSplitter::handle {
    background-color: #475569;
    width: 1px;
    height: 1px;
}

QSplitter::handle:hover {
    background-color: #3699FF;
}

/* ============ GROUP BOX ============ */
QGroupBox {
    background-color: #2D2D3F;
    border: 2px solid #475569;
    border-radius: 12px;
    margin-top: 16px;
    padding: 16px;
    font-weight: 700;
    color: #E2E8F0;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 4px 12px;
    background-color: #374151;
    border-radius: 6px;
    color: #3699FF;
    font-weight: 800;
}

/* ============ STATUS BAR ============ */
QStatusBar {
    background-color: #2D2D3F;
    border-top: 1px solid #475569;
    color: #94A3B8;
    font-size: 13px;
}

QStatusBar QLabel {
    color: #94A3B8;
}

/* ============ MENU BAR ============ */
QMenuBar {
    background-color: #2D2D3F;
    border-bottom: 1px solid #475569;
    color: #E2E8F0;
    padding: 4px;
}

QMenuBar::item {
    padding: 8px 16px;
    background-color: transparent;
    border-radius: 6px;
}

QMenuBar::item:selected {
    background-color: #374151;
    color: #3699FF;
}

QMenu {
    background-color: #2D2D3F;
    border: 2px solid #475569;
    border-radius: 12px;
    padding: 8px;
}

QMenu::item {
    padding: 10px 20px;
    border-radius: 8px;
    color: #E2E8F0;
}

QMenu::item:selected {
    background-color: #374151;
    color: #3699FF;
}

/* ============ DATE/TIME EDIT ============ */
QDateEdit, QTimeEdit, QDateTimeEdit {
    background-color: #2D2D3F;
    color: #E2E8F0;
    border: 1.5px solid #475569;
    border-radius: 8px;
    padding: 10px 14px;
    font-weight: 600;
}

QDateEdit:focus, QTimeEdit:focus, QDateTimeEdit:focus {
    border: 1.5px solid #3699FF;
}

QCalendarWidget {
    background-color: #2D2D3F;
    border: 2px solid #475569;
    border-radius: 12px;
}

QCalendarWidget QTableView {
    selection-background-color: #3699FF;
    selection-color: white;
}
