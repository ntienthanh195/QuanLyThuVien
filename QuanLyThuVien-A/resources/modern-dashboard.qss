/* ============================================================
   MASTER STYLESHEET - LIBRARY MANAGEMENT SYSTEM
   Theme: Deep Dark Professional
   Design Philosophy: Card-Based, Visual Hierarchy, Clean Spacing
   ============================================================ */

/* ============ COLOR PALETTE (Midnight Professional - Harmonized) ============
    Sidebar (Darkest):  #1a1f2e (midnight blue anchor)
    Background Main:    #232938 (mid-tone neutral)
    Table Body:         #2d3748 (lightest - content focus)
    Table Alt:          #262e3d (darker alternating)
    Table Header:       #1e2633 (darkest in table)
    Border:             #1a2332 (subtle separation)
    Accent Primary:     #4A90E2 (blue unchanged)
    Text Primary:       #e8eef5 (bright white)
    Text Secondary:     #a0aec0 (readable gray)
   Success:            #48bb78 (green)
   Warning:            #f6ad55 (orange)
   Danger:             #fc8181 (red)
   ======================================== */

/* ============ GLOBAL STRUCTURE ============ */
QWidget {
    font-family: "Segoe UI", "Roboto", sans-serif;
    font-size: 13px;
    color: #E2E8F0;
}

QTableView::item:selected, QTableWidget::item:selected {
    background-color: rgba(59, 130, 246, 0.15);
    color: #e4e4e7;
}

QHeaderView {
    background-color: #1e2633;
    border: none;
}

/* Nền chính: Midnight Professional - flat mid-tone */
QMainWindow, QWidget#CentralWidget,
.WidgetBangDieuKhien, .WidgetQuanLySach,
.WidgetQuanLyDocGia, .WidgetMuonTraSach {
    background-color: #232938;
}

/* ============ CARD CONTAINERS ============ */
QFrame[class="Card"] {
QHeaderView::section {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                               stop:0 #353b4a, stop:1 #2a2e39);
    color: #B5B5C3;
    padding: 14px 12px;
    border: none;
    border-bottom: 2px solid rgba(44, 93, 120, 0.3);
    font-weight: 700;
    text-transform: uppercase;
    font-size: 11px;
    letter-spacing: 1.2px;
}
    border: 1px solid #424959;
    border-radius: 8px;
    background-color: #353b4a;
    top: -1px;
}
QHeaderView::section:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                               stop:0 #424959, stop:1 #353b4a);
    color: #5ba3f5;
}
    font-weight: 800;
    color: #FFFFFF;
    margin-bottom: 15px;
    background: transparent;
}

QTabWidget::pane {
    border: 1px solid #424959;
    border-radius: 8px;
    background-color: #2a2e39;
    top: -1px;
}
    margin-bottom: 10px;
    background: transparent;
}

QLabel[class="SubText"] {
.ActionBar {
     padding: 6px 0;
     margin-bottom: 8px;
}
QTabBar::tab:selected {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                               stop:0 rgba(91, 163, 245, 0.18),
                               stop:1 transparent);
    color: #5ba3f5;
    border-bottom: 3px solid qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                            stop:0 #5ba3f5, stop:1 #5cd68d);
    font-weight: 700;
}
     background: #2B2B40; color: #B5B5C3;
}
    color: #9B9B9B;
    font-size: 12px;
.BtnCompact { min-height: 34px; padding: 6px 10px; font-size: 13px; }
    background: transparent;
QScrollBar:vertical {
    background-color: #2a2e39;
    width: 12px;
    border-radius: 6px;
    margin: 2px;
}
    border-radius: 6px;
    padding: 8px;
}

QToolBar[class="ToolbarDark"] QToolButton {
QScrollBar::handle:vertical {
    background-color: #424959;
    border-radius: 6px;
    min-height: 30px;
}
    font-weight: 600;
}

QScrollBar::handle:vertical:hover {
    background-color: #5ba3f5;
}
    border-color: #4A90E2;
}

QDialog {
    background-color: #353b4a;
}
    font-weight: 700;
    padding: 12px 0;
    background: transparent;
QMessageBox {
    background-color: #353b4a;
}
    padding: 12px;
    background: #FEE2E2;
    border: 1px solid #FCA5A5;
    border-radius: 8px;
    color: #991B1B;
}

QLabel[class="PlaceholderMsg"] {
    padding: 40px;
QProgressBar {
    border: none;
    border-radius: 8px;
    background-color: #353b4a;
    text-align: center;
    color: #E2E8F0;
    font-weight: 700;
    height: 20px;
}
}

QTabWidget[class="TabCustom"]::pane {
    background-color: #141414;
    border: 1px solid #0D0D0D;
    border-radius: 12px;
}
QCheckBox::indicator {
    width: 20px;
    height: 20px;
    border: 2px solid #424959;
    border-radius: 6px;
    background-color: #353b4a;
}
    font-size: 14px;
}

QTabWidget[class="TabCustom"] QTabBar::tab:selected {
    background-color: #3B82F6;
    color: white;
    font-weight: bold;
}

QLabel[class="LabelSearchTitle"] {
    color: #B5B5C3;
    font-size: 13px;
    font-weight: 700;
}

QLineEdit[class="InputDark"], QLineEdit[class="InputISBN"] {
    background-color: #2a2e39;
    color: #f0f4f8;
    border: 1px solid #424959;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 13px;
}

QLineEdit[class="InputDark"]:focus { border: 1px solid #5ba3f5; }
QLineEdit[class="InputISBN"]:focus { border: 1px solid #1BC5BD; }
QLineEdit[class="InputISBN"]:disabled { color: #6C6C80; }

QPushButton[class="GradientPrimary"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #5ba3f5, stop:1 #3d7dc4);
    color: white; border: none; border-radius: 8px; font-weight: bold;
}
QPushButton[class="GradientPrimary"]:hover { background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #4a93e3, stop:1 #2e6aad); }

QPushButton[class="Accent"] {
    background-color: #0f9a86; /* muted teal */
    color: white; border: none; border-radius: 8px; font-size: 18px;
}
QPushButton[class="Accent"]:hover { background-color: #0e8978; }
QPushButton[class="Accent"]:disabled { background-color: #2B2B40; color: #6C6C80; }

QPushButton[class="AccentPurple"] {
    background-color: #6B46C1; color: white; border: none; border-radius: 6px; font-weight: bold; font-size: 13px;
}
QPushButton[class="AccentPurple"]:hover { background-color: #5a34b0; }
QPushButton[class="AccentPurple"]:disabled { background-color: #2B2B40; color: #6C6C80; }

QGroupBox[class="GroupBoxProfile"], QGroupBox[class="GroupBoxBooks"], QGroupBox[class="GroupBoxInput"] {
    background-color: #353b4a;
    border: 1px solid #424959;
    border-radius: 8px;
    padding: 15px;
    font-weight: bold;
    font-size: 13px;
}
QGroupBox[class="GroupBoxProfile"] { color: #ffb84d; }
QGroupBox[class="GroupBoxBooks"] { color: #5ba3f5; }
QGroupBox[class="GroupBoxInput"] { color: #5cd68d; }

QLabel[class="InfoBox"] {
    color: #b8c5d6; font-size: 13px; padding: 15px; background-color: #353b4a; border-radius: 6px;
}

QTableView[class="InnerTable"] {
    background-color: #1a1f2e; /* match sidebar darkness */
    alternate-background-color: #1e2633; /* slightly lighter alternating */
    color: #e8eef5; gridline-color: rgba(255,255,255,0.05); border: 1px solid #141920; border-radius: 6px; font-size: 12px;
}
QTableView[class="InnerTable"] QHeaderView::section { background-color: #141b26; color: #a0aec0; border: none; border-bottom: 1px solid #0f1419; padding: 10px 8px; font-weight: bold; }

/* Force table background for specific management widgets to match sidebar tone */
/* Stronger selectors (object name + class) to override generic table rules */
QWidget#WidgetQuanLySach QTableView, QWidget#WidgetQuanLySach QTableWidget,
.WidgetQuanLySach QTableView, .WidgetQuanLySach QTableWidget,
QWidget#WidgetQuanLyDocGia QTableView, QWidget#WidgetQuanLyDocGia QTableWidget,
.WidgetQuanLyDocGia QTableView, .WidgetQuanLyDocGia QTableWidget {
    background-color: #2c3e50; /* deep slate blue matching screenshot */
    alternate-background-color: #273747;
    color: #f0f4f8;
}

QWidget#WidgetQuanLySach QHeaderView::section, .WidgetQuanLySach QHeaderView::section,
QWidget#WidgetQuanLyDocGia QHeaderView::section, .WidgetQuanLyDocGia QHeaderView::section {
    background-color: #34495e;
    color: #b8c5d6;
    border: none;
    border-bottom: 1px solid #1e2938;
    padding: 10px 8px;
}
QTableView[class="InnerTable"]::item:selected { background-color: #4A7BA7; color: white; }
QTableView::item:selected, QTableWidget::item:selected { background-color: #4A7BA7; color: white; }

/* Small icon-only buttons used in search bars */
QPushButton[class="IconButton"] {
    min-width: 40px;
    min-height: 40px;
    padding: 0;
    border-radius: 8px;
    background: #3d4555;
    color: #b8c5d6;
}
QPushButton[class="IconButton"]:hover { background: #4a5266; color: #f0f4f8; border-color: #5ba3f5; }

/* Icon buttons that also show a short text label (e.g. 'Quét', 'Làm mới') */
QPushButton[class="IconButton"][role="withText"] {
    min-width: 90px;
    min-height: 40px;
    padding: 6px 12px;
    border-radius: 8px;
    background: #3d4555;
    color: #b8c5d6;
    qproperty-iconSize: 18px 18px;
    text-align: left;
}
QPushButton[class="IconButton"][role="withText"]:hover { background: #4a5266; color: #f0f4f8; }

/* Selected reader info box (right panel) */
QLabel[class="SelectedInfo"] {
    background-color: #353b4a;
    color: #f0f4f8;
    padding: 18px;
    border-radius: 10px;
    font-size: 13px;
}
QLabel[class="SelectedInfo"][state="empty"] { color: #b8c5d6; background-color: #2a2e39; }
/* Filled variant: visible panel when a reader is selected */
QLabel[class="SelectedInfo"][state="filled"][stripe="odd"] {
    background-color: qlineargradient(x1:0,y1:0,x2:1,y2:1, stop:0 #3a3f4d, stop:1 #353b4a);
    color: #f0f4f8;
    border: 1px solid #424959;
    padding: 18px;
    border-radius: 10px;
}
QLabel[class="SelectedInfo"][state="filled"][stripe="odd"] b { color: #FFFFFF; }

/* Even-striped selection: keep panel subtle (no strong background) */
QLabel[class="SelectedInfo"][state="filled"][stripe="even"] {
    /* Always show a subtle background even for even rows */
    background-color: qlineargradient(x1:0,y1:0,x2:1,y2:1, stop:0 #0f1418, stop:1 #071119);
    color: #FFFFFF;
    border: 1px solid rgba(255,255,255,0.03);
    padding: 18px;
    border-radius: 10px;
}

QCheckBox[class="CheckboxBold"] { color: #B5B5C3; font-size: 13px; font-weight: bold; }
QCheckBox[class="CheckboxBold"]::indicator { width: 20px; height: 20px; }
QCheckBox[class="CheckboxBold"]::indicator:unchecked { border: 2px solid #5a6a7a; border-radius: 4px; background-color: #353b4a; }
QCheckBox[class="CheckboxBold"]::indicator:checked { border: 2px solid #1BC5BD; border-radius: 4px; background-color: #1BC5BD; image: url(:/icons/check.svg); }
QCheckBox[class="CheckboxBold"]:disabled { color: #6C6C80; }

/* Dashboard alert cards */
QWidget[class="AlertCardDanger"] {
    background: #353b4a;
    border-radius: 12px;
    border-left: 4px solid #ff6b6b;
}

QWidget[class="AlertCardWarning"] {
    background: #353b4a;
    border-radius: 12px;
    border-left: 4px solid #ffb84d;
}

/* Standardize primary/success/danger/secondary colors to match Quản Lý Sách */
QPushButton[class="Primary"], QPushButton[class="GradientPrimary"] {
    background: #4A90E2; color: white; border: none; border-radius: 8px; font-weight: 700;
}
QPushButton[class="Primary"]:hover, QPushButton[class="GradientPrimary"]:hover { background: #3a7bc8; }

QPushButton[class="Success"] {
    background: #1BC5BD; color: white; border: none; border-radius: 8px; font-weight: 700;
}
QPushButton[class="Success"]:hover { background: #0e9d95; }

QPushButton[class="Danger"] {
    background: #F64E60; color: white; border: none; border-radius: 8px; font-weight: 700;
}
QPushButton[class="Danger"]:hover { background: #d32f2f; }

QPushButton[class="Danger_old"] {
    background: #fc8181; color: white; border: none; border-radius: 8px; font-weight: 700;
}
QPushButton[class="Danger"]:hover { background: #f56565; }

QPushButton[class="Secondary"] {
    background: #2B2B40; color: #B5B5C3; border: none; border-radius: 8px; font-weight: 600;
}

/* Compact button property used for action bars and small controls */
QPushButton[compact="true"] {
    min-height: 34px; padding: 6px 10px; font-size: 13px; border-radius: 6px;
}

/* Action bar container (buttons above tables) */
QWidget[class="ActionBar"] {
    padding: 6px 0; margin-bottom: 8px;
}
QWidget[class="ActionBar"] QPushButton { min-height: 34px; padding: 6px 12px; border-radius: 6px; }


QWidget[class="IconWidgetDanger"], QWidget[class="IconWidgetWarning"] {
    border-radius: 12px;
}

QWidget[class="IconWidgetDanger"] { background-color: #FEE2E2; }
QWidget[class="IconWidgetWarning"] { background-color: #FEF3C7; }

QLabel[class="IconLabelDanger"] { background: transparent; border: none; color: #DC2626; }

QLabel[class="CardDescription"] { color: #A0A0B0; font-size: 12px; background: transparent; }

/* MainWindow and Sidebar styles */
QMainWindow[class="MainWindow"], QWidget[class="MainWindow"] {
    background-color: #071233;
}

QLabel[class="SidebarTitle"] {
    color: #FFFFFF;
    padding: 24px 16px 18px 16px;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 rgba(54,153,255,0.08), stop:1 transparent);
    border-bottom: 2px solid rgba(54,153,255,0.2);
    margin-bottom: 8px;
    font-weight: 700;
}

QPushButton[class="MenuButton"] {
    background-color: #5B7FFF;
    color: white;
    border: none;
    border-radius: 8px;
    padding: 16px 24px;
    text-align: left;
}
QPushButton[class="MenuButton"]:hover { background-color: #4C6FE8; }
QPushButton[class="MenuButton"]:pressed { background-color: #3D5FD9; }

QPushButton[class="MenuButtonOrange"] { background-color: #f39c12; color: white; }
QPushButton[class="MenuButtonPurple"] { background-color: #9b59b6; color: white; }
QPushButton[class="MenuButtonTeal"] { background-color: #16a085; color: white; }
QPushButton[class="MenuButtonWarning"] { background-color: #e67e22; color: white; }
QPushButton[class="MenuButtonDanger"] { background-color: #e74c3c; color: white; }

/* Action bar container (buttons above tables) */
QFrame[class="ActionBar"], QFrame[class="nhomChucNang"] {
    background: transparent;
}

QPushButton[class="Primary"], QPushButton[class="GradientPrimary"] {
    padding: 10px 18px;
}

/* Legacy support */
QLabel[class="HeaderTitle"] {
    font-size: 24px;
    font-weight: bold;
    color: #FFFFFF;
    padding-bottom: 10px;
    background: transparent;
}

QLabel[class="SectionTitle"] {
    font-size: 16px;
    font-weight: 600;
    color: #FFFFFF;
    background: transparent;
}

/* ============ SIDEBAR - ROUNDED PILL STYLE ============ */
QListWidget#Sidebar, QListWidget {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                               stop:0 #213745, stop:1 #15202a);
    border: none;
    border-right: 1px solid rgba(43, 120, 180, 0.08);
    outline: 0;
    padding-top: 0px;
}

QListWidget#Sidebar::item, QListWidget::item {
    color: #a1a1aa;
    padding: 14px 20px;
    margin: 8px 16px;
    border-radius: 12px;
    font-weight: 600;
    font-size: 14px;
    background-color: transparent;
    border: none;
}

QListWidget#Sidebar::item:hover, QListWidget::item:hover {
    background: rgba(59, 130, 246, 0.12);
    color: #60a5fa;
    transform: translateX(2px);
}

QListWidget#Sidebar::item:selected, QListWidget::item:selected {
    background: rgba(59, 130, 246, 0.20);
    color: #ffffff;
    font-weight: 700;
    border: none;
}

/* ============ BUTTONS ============ */
QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                               stop:0 #27272a, stop:1 #18181b);
    color: #a1a1aa;
    border: 1.5px solid #3f3f46;
    border-radius: 8px;
    padding: 12px 24px;
    font-weight: 600;
    font-size: 13px;
}

QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                               stop:0 #3f3f46, stop:1 #27272a);
    border: 1.5px solid #60a5fa;
    color: #60a5fa;
}

QPushButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                               stop:0 #18181b, stop:1 #09090b);
}

QPushButton:disabled {
    background-color: #18181b;
    color: #52525b;
    border-color: #3f3f46;
}

/* Primary Button - Muted Blue (match Book UI) */
QPushButton[class="Primary"], QPushButton[class="btn-primary"] {
    background-color: #2B6CB0; /* muted blue */
    color: white;
    border: none;
    font-weight: 700;
    padding: 10px 20px;
    border-radius: 8px;
}

QPushButton[class="Primary"]:hover, QPushButton[class="btn-primary"]:hover {
    background-color: #23588f;
}

QPushButton[class="Primary"]:pressed, QPushButton[class="btn-primary"]:pressed {
    background-color: #1b3a62;
}

/* Secondary Button */
QPushButton[class="Secondary"], QPushButton[class="btn-secondary"] {
    background-color: #323248;
    color: #B5B5C3;
    border: 1px solid #323248;
    font-weight: 600;
}

QPushButton[class="Secondary"]:hover, QPushButton[class="btn-secondary"]:hover {
    background-color: #2A2A3C;
    color: white;
}

/* Success Button - Subtle Green */
QPushButton[class="Success"], QPushButton[class="btn-success"] {
    background-color: #13803d; /* darker, less saturated green */
    color: white;
    border: none;
    font-weight: 600;
    padding: 10px 20px;
    border-radius: 8px;
}
QPushButton[class="Success"]:hover, QPushButton[class="btn-success"]:hover {
    background-color: #0f6f35;
}
QPushButton[class="Success"]:pressed, QPushButton[class="btn-success"]:pressed {
    background-color: #0c5d2c;
}

/* Danger Button - Muted Red */
QPushButton[class="Danger"], QPushButton[class="btn-danger"] {
    background-color: #C53030; /* slightly darker/muted red */
    color: white;
    border: none;
    font-weight: 600;
    padding: 10px 20px;
    border-radius: 8px;
}
QPushButton[class="Danger"]:hover, QPushButton[class="btn-danger"]:hover {
    background-color: #a82a2a;
}

/* ============ INPUT FIELDS ============ */
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDateEdit {
    background-color: #18181b;
    border: 2px solid #3f3f46;
    border-radius: 8px;
    padding: 10px 15px;
    color: #e4e4e7;
    font-weight: 500;
    selection-background-color: #3B82F6;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QSpinBox:focus, QDateEdit:focus {
    border: 2px solid #60a5fa;
    background-color: #27272a;
    outline: none;
}

QLineEdit:disabled, QTextEdit:disabled, QPlainTextEdit:disabled {
    background-color: #18181b;
    color: #52525b;
    border-color: #3f3f46;
}

/* ============ COMBO BOX ============ */
QComboBox {
    background-color: #151521; /* Nền input tối hơn nền Card */
    color: #FFFFFF;
    border: 2px solid #2B2B40;
    border-radius: 8px;
    padding: 8px 12px;
    min-width: 140px;
    font-weight: 500;
}

QComboBox:focus {
    border: 2px solid #2C5D78;
    background-color: #1A1A26;
}
/* ============ TABLES ============ */
QTableView, QTableWidget {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #2B6CB0, stop:1 #194F7A);
    border: 1px solid #1F4D6E;
    border-radius: 8px;
    gridline-color: rgba(255,255,255,0.03);
    selection-background-color: rgba(43,108,176,0.18); /* lighter selection using primary */
    selection-color: #FFFFFF;
    outline: 0;
    color: #E6EEF6;
}

QTableView::item, QTableWidget::item {
    padding: 8px;
    border-bottom: 1px solid #3f3f46;
}

QTableView::item:hover, QTableWidget::item:hover {
    background-color: rgba(59, 130, 246, 0.08);
}

QTableView::item:selected, QTableWidget::item:selected {
    background-color: rgba(59, 130, 246, 0.15);
    color: #e4e4e7;
}

QHeaderView {
    background-color: #27272a;
    border: none;
}

QHeaderView::section {
    background-color: #18181b;
    color: #a1a1aa;
    padding: 12px;
    border: none;
    border-bottom: 2px solid #3f3f46;
    font-weight: 700;
    text-transform: uppercase;
    font-size: 11px;
    letter-spacing: 1px;
}

QHeaderView::section:hover {
    background-color: #27272a;
    color: #60a5fa;
}   background-color: rgba(54, 153, 255, 0.08);
}

QTableView::item:selected, QTableWidget::item:selected {
    background-color: rgba(44, 93, 120, 0.15);
    color: #FFFFFF;
}

QHeaderView {
    background-color: #1E1E2D;
    border: none;
}

QHeaderView::section {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                               stop:0 #232334, stop:1 #1E1E2D);
    color: #B5B5C3;
    padding: 14px 12px;
    border: none;
    border-bottom: 2px solid rgba(44, 93, 120, 0.3);
    font-weight: 700;
    text-transform: uppercase;
    font-size: 11px;
    letter-spacing: 1.2px;
}

QHeaderView::section:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                               stop:0 #2B2B40, stop:1 #232334);
    color: #2C5D78;
}

/* ============ LABELS ============ */
QLabel {
    color: #FFFFFF;
    background-color: transparent;
    border: none;
}

QLabel[class="SubText"] {
    color: #9B9B9B;
    font-size: 12px;
    background: transparent;
}
QTabWidget::pane {
    border: 1px solid #2B2B40;
    border-radius: 8px;
    background-color: #1E1E2D;
    top: -1px;
}

QTabBar::tab {
    background-color: transparent;
    color: #B5B5C3;
    border: none;
    border-bottom: 3px solid transparent;
    padding: 14px 28px;
    margin-right: 6px;
    font-weight: 600;
    font-size: 14px;
    border-radius: 8px 8px 0 0;
}

QTabBar::tab:selected {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                               stop:0 rgba(44, 93, 120, 0.15),
                               stop:1 transparent);
    color: #2C5D78;
    border-bottom: 3px solid qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                            stop:0 #2C5D78, stop:1 #6AA77F);
    font-weight: 700;
}

QTabBar::tab:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                               stop:0 rgba(54, 153, 255, 0.12),
                               stop:1 transparent);
    color: #3699FF;
}
/* ============ SCROLLBAR - Dark Theme ============ */
QScrollBar:vertical {
    background-color: #1E293B;
    width: 12px;
    border-radius: 6px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background-color: #475569;
    border-radius: 6px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background-color: #64748B;
}

QScrollBar::handle:vertical:pressed {
    background-color: #2C5D78;
}

QScrollBar:horizontal {
    background-color: #1E293B;
    height: 10px;
    border-radius: 5px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background-color: #475569;
    border-radius: 5px;
    min-width: 40px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #2C5D78;
}

QScrollBar::add-line, QScrollBar::sub-line {
    background: none;
    border: none;
    width: 0;
    height: 0;
}

QScrollBar::add-page, QScrollBar::sub-page {
    background: none;
}

/* ============ SPIN BOX ============ */
QSpinBox, QDoubleSpinBox {
    background-color: #2D2D3F;
    color: #E2E8F0;
    border: 1.5px solid #475569;
    border-radius: 8px;
    padding: 10px 14px;
    font-weight: 600;
}

QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1.5px solid #2C5D78;
}

QSpinBox::up-button, QDoubleSpinBox::up-button,
QSpinBox::down-button, QDoubleSpinBox::down-button {
    background-color: #374151;
    border: none;
    border-radius: 6px;
    width: 20px;
    margin: 2px;
}

QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: #2C5D78;
}

/* ============ DIALOGS ============ */
QDialog {
    background-color: #1E1E2D;
}

QDialog QPushButton {
    min-width: 100px;
}

/* ============ MESSAGE BOX ============ */
QMessageBox {
    background-color: #2D2D3F;
}

QMessageBox QLabel {
    color: #E2E8F0;
    font-size: 14px;
}

/* ============ PROGRESS BAR ============ */
QProgressBar {
    border: none;
    border-radius: 8px;
    background-color: #1E293B;
    text-align: center;
    color: #E2E8F0;
    font-weight: 700;
    height: 20px;
}

QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #2C5D78, stop:1 #6AA77F);
    border-radius: 8px;
}

/* ============ CHECKBOX ============ */
QCheckBox {
    color: #E2E8F0;
    font-weight: 600;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 20px;
    height: 20px;
    border: 2px solid #475569;
    border-radius: 6px;
    background-color: #2D2D3F;
}

QCheckBox::indicator:hover {
    border-color: #2C5D78;
}

QCheckBox::indicator:checked {
    background-color: #2C5D78;
    border-color: #2C5D78;
}

/* ============ RADIO BUTTON ============ */
QRadioButton {
    color: #E2E8F0;
    font-weight: 600;
    spacing: 8px;
}

QRadioButton::indicator {
    width: 20px;
    height: 20px;
    border: 2px solid #475569;
    border-radius: 10px;
    background-color: #2D2D3F;
}

QRadioButton::indicator:hover {
    border-color: #2C5D78;
}

QRadioButton::indicator:checked {
    background-color: #2C5D78;
    border-color: #3699FF;
}

/* ============ TOOLBAR ============ */
QToolBar {
    background-color: #2D2D3F;
    border: none;
    border-bottom: 1px solid #475569;
    padding: 8px;
    spacing: 8px;
}

QToolButton {
    background-color: transparent;
    border: none;
    border-radius: 8px;
    padding: 8px;
    color: #94A3B8;
}

QToolButton:hover {
    background-color: #374151;
    color: #3699FF;
}

QToolButton:pressed {
    background-color: #1E293B;
}

/* ============ SPLITTER ============ */
QSplitter::handle {
    background-color: #475569;
    width: 1px;
    height: 1px;
}

QSplitter::handle:hover {
    background-color: #3699FF;
}

/* ============ GROUP BOX ============ */
QGroupBox {
    background-color: #2D2D3F;
    border: 2px solid #475569;
    border-radius: 12px;
    margin-top: 16px;
    padding: 16px;
    font-weight: 700;
    color: #E2E8F0;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 4px 12px;
    background-color: #374151;
    border-radius: 6px;
    color: #3699FF;
    font-weight: 800;
}

/* ============ STATUS BAR ============ */
QStatusBar {
    background-color: #2D2D3F;
    border-top: 1px solid #475569;
    color: #94A3B8;
    font-size: 13px;
}

QStatusBar QLabel {
    color: #94A3B8;
}

/* ============ MENU BAR ============ */
QMenuBar {
    background-color: #2D2D3F;
    border-bottom: 1px solid #475569;
    color: #E2E8F0;
    padding: 4px;
}

QMenuBar::item {
    padding: 8px 16px;
    background-color: transparent;
    border-radius: 6px;
}

QMenuBar::item:selected {
    background-color: #374151;
    color: #3699FF;
}

QMenu {
    background-color: #2D2D3F;
    border: 2px solid #475569;
    border-radius: 12px;
    padding: 8px;
}

QMenu::item {
    padding: 10px 20px;
    border-radius: 8px;
    color: #E2E8F0;
}

QMenu::item:selected {
    background-color: #374151;
    color: #3699FF;
}

/* ============ DATE/TIME EDIT ============ */
QDateEdit, QTimeEdit, QDateTimeEdit {
    background-color: #2D2D3F;
    color: #E2E8F0;
    border: 1.5px solid #475569;
    border-radius: 8px;
    padding: 10px 14px;
    font-weight: 600;
}

QDateEdit:focus, QTimeEdit:focus, QDateTimeEdit:focus {
    border: 1.5px solid #3699FF;
}

QCalendarWidget {
    background-color: #2D2D3F;
    border: 2px solid #475569;
    border-radius: 12px;
}

QCalendarWidget QTableView {
    selection-background-color: #3699FF;
    selection-color: white;
}
